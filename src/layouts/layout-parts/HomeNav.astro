---
interface Props {
  img?: string;
}
const { img } = Astro.props;
---

<header
  id="nav-container"
  class="h-lvh w-full bg-cover bg-fixed bg-top bg-blend-lighten"
  style=`background-image: url(${img});`
>
  <div
    id="nav-bg"
    class="relative flex h-full flex-col items-center bg-neutral-200"
  >
    <slot />
    <div
      id="header-bg"
      class="ml-[10vw] flex w-1/3 flex-1 flex-col justify-center gap-12 self-start"
    >
      <p class="text-xl">Linde</p>
      <h1 class="text-6xl font-bold">
        Lorem, ipsum dolor sit amet consectetur adipisicing elit.
      </h1>
      <a id="more-link" class="btn btn-primary text-lg font-bold uppercase">
        Me Shume
      </a>
    </div>
    <div
      class="absolute bottom-12 right-12 flex w-1/3 gap-4 rounded-xl bg-neutral-200/75 p-4"
    >
      <button id="li" class="aspect-video flex-1">
        <img class="h-full w-full" src="/img/home-bg.webp" alt="" />
      </button>
      <button id="ha" class="aspect-video flex-1 opacity-60">
        <img class="h-full w-full" src="/img/hansaflex_carousel.webp" alt="" />
      </button>
      <button id="hp" class="aspect-video flex-1 opacity-60">
        <img
          class="h-full w-full"
          src="/img/hoppecke_carousel.webp"
          alt="Hoppecke"
        />
      </button>
    </div>
  </div>
</header>
<script>
  import { scroll, animate } from "motion";
  const mainNav = document.getElementById("main-nav") as HTMLDivElement;
  const navBg = document.getElementById("nav-bg") as HTMLDivElement;
  const hpBtn = document.getElementById("hp") as HTMLDivElement;
  const haBtn = document.getElementById("ha") as HTMLDivElement;
  const liBtn = document.getElementById("li") as HTMLDivElement;
  const navContainer = document.getElementById(
    "nav-container",
  ) as HTMLDivElement;

  const changeCarousel = (
    title: string,
    text: string,
    href: string,
    imgUrl: string,
    btnIndex: number,
  ) => {
    navContainer.getElementsByTagName("a")[0].href = href;
    const titleEl = navContainer.getElementsByTagName("p")[0];
    const textEl = navContainer.getElementsByTagName("h1")[0];
    const btnEl = navContainer.querySelector("#more-link") as HTMLAnchorElement;
    const btnArray = [liBtn, haBtn, hpBtn];
    btnArray.forEach((_, i) => {
      if (i === btnIndex) btnArray[i].style.opacity = "1";
      else btnArray[i].style.opacity = "0.6";
    });
    animate(
      (progress) => {
        navContainer.style.backgroundColor = `rgba(255,255,255,${progress})`;
      },
      { duration: 0.25 },
    );
    animate("#header-bg", { opacity: 0 }, { duration: 0.25 }).finished.then(
      () => {
        titleEl.innerText = title;
        textEl.innerText = text;
        navContainer.style.backgroundImage = `url(${imgUrl})`;
        btnEl.href = href;
        animate("#header-bg", { opacity: 1 }, { duration: 0.25 });
        animate(
          (progress) => {
            navContainer.style.backgroundColor = `rgba(255,255,255,${1 - progress})`;
          },
          { duration: 0.25 },
        );
      },
    );
  };

  liBtn.onclick = (e) => {
    changeCarousel(
      "Linde",
      "Velit cursus nibh sed fermentum tempus enim et elit ut.",
      "/products/linde",
      "/img/home-bg.webp",
      0,
    );
  };

  haBtn.onclick = (e) => {
    changeCarousel(
      "HansaFlex",
      "Velit cursus nibh sed fermentum tempus enim et elit ut.",
      "/products/hansaflex",
      "/img/hansaflex_carousel.webp",
      1,
    );
  };

  hpBtn.onclick = (e) => {
    changeCarousel(
      "Hoppecke",
      "Velit cursus nibh sed fermentum tempus enim et elit ut.",
      "#",
      "/img/hoppecke_carousel.webp",
      2,
    );
  };

  let i = 2;
  window.setInterval(() => {
    if(i>3) i = 1;
    console.log("index",i)
    if (window.scrollY / window.innerHeight >= 0.2) return;
    if (i % 3 === 0) {
      hpBtn.click();
    } else if (i % 2 === 0) {
      haBtn.click();
    } else {
      liBtn.click();
    }
    i++;
  }, 10000);

  const netContainerHeight = navContainer.clientHeight - mainNav.clientHeight;
  const header = document.getElementById("header-bg") as HTMLDivElement;
  scroll(({ y }) => {
    mainNav.style.backgroundColor = `rgba(230, 231, 235,${
      y.current / netContainerHeight
    })`;
    let mainNavWidth =
      66 +
      ((y.current + mainNav?.clientHeight) / navContainer?.clientHeight!) * 33;
    let navBgOpacity = y.current / navContainer?.clientHeight! + 0.45;
    mainNavWidth = mainNavWidth < 100 ? mainNavWidth : 100;
    mainNav.style.width = `${mainNavWidth}vw`;
    if (navBg)
      navBg.style.backgroundColor = `rgba(230, 231, 235,${navBgOpacity})`;
    if (header)
      header.style.opacity = `${1 - y.current / (netContainerHeight / 2.7) / 5}`;
    if (navContainer)
      navContainer.style.backgroundColor = `rgba(230, 231, 235,${
        y.current / netContainerHeight
      })`;
  });
</script>
