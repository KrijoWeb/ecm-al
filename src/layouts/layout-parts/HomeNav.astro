---
interface Props {
  img?: string;
}
const { img } = Astro.props;
---

<header
  id="nav-container"
  class="h-lvh w-full bg-cover bg-fixed bg-top bg-blend-lighten"
  style=`background-image: url(${img});`
>
  <div
    id="nav-bg"
    class="relative flex h-full flex-col items-center bg-neutral-200"
  >
    <slot />
    <div
      id="header-bg"
      class="ml-[10vw] flex w-1/3 flex-1 flex-col justify-center self-start"
    >
      <div class="flex flex-col gap-12">
        <h1 class="text-6xl font-bold">
          Mjete LINDE, për perpunimin e ngarkesave
        </h1>
        <a
          id="more-link"
          class="btn btn-primary text-lg font-bold uppercase"
          href="/products/linde"
        >
          Me Shume
        </a>
      </div>
    </div>
    <div
      class="absolute bottom-12 right-12 flex w-1/3 gap-4 rounded-xl bg-neutral-200/75 p-4"
    >
      <button id="li" class="aspect-video flex-1">
        <img class="h-full w-full" src="/img/home-bg.webp" alt="" />
      </button>
      <button id="ha" class="aspect-video flex-1 opacity-60">
        <img class="h-full w-full" src="/img/hansaflex_carousel.webp" alt="" />
      </button>
      <button id="hp" class="aspect-video flex-1 opacity-60">
        <img
          class="h-full w-full"
          src="/img/hoppecke_carousel.webp"
          alt="Hoppecke"
        />
      </button>
    </div>
  </div>
</header>
<script>
  import { scroll, animate, cubicBezier } from "motion";
  const mainNav = document.getElementById("main-nav") as HTMLDivElement;
  const subMenu = document.getElementById("company-submenu") as HTMLDivElement;
  const navBg = document.getElementById("nav-bg") as HTMLDivElement;
  const hpBtn = document.getElementById("hp") as HTMLDivElement;
  const haBtn = document.getElementById("ha") as HTMLDivElement;
  const liBtn = document.getElementById("li") as HTMLDivElement;
  const navContainer = document.getElementById(
    "nav-container",
  ) as HTMLDivElement;

  const changeCarousel = (
    companySrc: string,
    text: string,
    href: string,
    imgUrl: string,
    btnIndex: number,
  ) => {
        const textEl = navContainer.getElementsByTagName(
      "h1",
    )[0] as HTMLHeadElement;
    const btnEl = navContainer.querySelector("#more-link") as HTMLAnchorElement;
    console.log(btnEl)
    const btnArray = [liBtn, haBtn, hpBtn];
    btnArray.forEach((_, i) => {
      if (i === btnIndex) btnArray[i].style.opacity = "1";
      else btnArray[i].style.opacity = "0.6";
    });
    animate(0, 1, {
      onUpdate: (progress) => {
        navContainer.style.backgroundColor = `rgba(255,255,255,${progress})`;
      },
      duration: 0.25,
    });
    animate("#header-bg", { opacity: 0 }, { duration: 0.25 }).finished.then(
      () => {
        // companyLogo.src = companySrc;
        textEl.innerText = text;
        navContainer.style.backgroundImage = `url(${imgUrl})`;
        console.log(btnEl)
        btnEl.href = href;
        animate("#header-bg", { opacity: 1 }, { duration: 0.25 });
        animate(0, 1, {
          onUpdate: (progress) => {
            navContainer.style.backgroundColor = `rgba(255,255,255,${1 - progress})`;
          },
          duration: 0.25,
        });
      },
    );
  };

  liBtn.onclick = (e) => {
    changeCarousel(
      "/img/linde-logo.svg",
      "Mjete LINDE, për perpunimin e ngarkesave",
      "/products/linde",
      "/img/home-bg.webp",
      0,
    );
  };

  haBtn.onclick = (e) => {
    changeCarousel(
      "/img/hf-logo.svg",
      "Hidraulika HANSA FLEX",
      "/products/hansaflex",
      "/img/hansaflex_carousel.webp",
      1,
    );
  };

  hpBtn.onclick = (e) => {
    changeCarousel(
      "/img/hp-logo.png",
      "Bateri industriale HOPPECKE",
      "/products/hoppecke",
      "/img/hoppecke_carousel.webp",
      2,
    );
  };

  let i = 2;
  window.setInterval(() => {
    if (i > 3) i = 1;
    if (window.scrollY / window.innerHeight >= 0.2) return;
    if (i % 3 === 0) {
      hpBtn.click();
    } else if (i % 2 === 0) {
      haBtn.click();
    } else {
      liBtn.click();
    }
    i++;
  }, 10000);

  const netContainerHeight = navContainer.clientHeight - mainNav.clientHeight;
  const header = document.getElementById("header-bg") as HTMLDivElement;
  const mainLogo = document.getElementById("main-logo") as HTMLImageElement;
  const easing = cubicBezier(0, 0, 1, 0.8);
  scroll(
    (_, { y }) => {
      mainNav.style.backgroundColor = `rgba(230, 231, 235,${easing(
        y.current / netContainerHeight,
      )})`;
      subMenu.style.backgroundColor = `rgba(230, 231, 235,${easing(
        y.current / netContainerHeight,
      )})`;
      let mainLogoWidth = 22 - 14 * Math.min(y.current / netContainerHeight, 1);
      mainLogo.style.width = `${mainLogoWidth}rem`;
      let mainNavWidth =
        66 +
        ((y.current + mainNav?.clientHeight) / navContainer?.clientHeight!) *
          33;
      let navBgOpacity = y.current / navContainer?.clientHeight!;
      mainNavWidth = mainNavWidth < 100 ? mainNavWidth : 100;
      mainNav.style.width = `${mainNavWidth}vw`;
      if (navBg)
        navBg.style.backgroundColor = `rgba(230, 231, 235,${Math.max(0.35, easing(navBgOpacity))})`;
      if (header)
        header.style.opacity = `${1 - easing(y.current / netContainerHeight)}`;
      if (navContainer)
        navContainer.style.backgroundColor = `rgba(230, 231, 235,${Math.max(
          0.35,
          easing(y.current / netContainerHeight),
        )})`;
    },
    { target: document.getElementById("nav-container") },
  );
</script>
