---
import InstaLogo from "../../svg/instagram.svg?raw";
import LocationSvg from "../../svg/location.svg?raw";
import EmailSvg from "../../svg/email.svg?raw";

const logos = [InstaLogo, LocationSvg, EmailSvg];
---

<div id="main-nav" class="fixed z-[100] flex w-full bg-neutral px-10">
  <a href="/" class="my-2">
    <img src="/img/EMC_Logo_Black.png" alt="Logo" class="h-14 object-contain" />
  </a>
  <div
    class="mx-16 flex w-[80vw] items-stretch border-b-2 border-b-neutral-400 [&>*]:py-4"
  >
    <nav class="flex flex-1 items-center justify-around">
      <div class="dropdown dropdown-hover">
        <div
          tabindex="0"
          role="button"
          class="text-gray-800 hover:text-gray-600"
        >
          PRODUKTET
        </div>
        <ul
          tabindex="0"
          class="menu dropdown-content z-[100] w-52 rounded-none bg-neutral p-2 shadow"
        >
          <li><a href="/products/linde">Linde</a></li>
          <li><a href="/products/hansaflex">HansaFlex</a></li>
          <li><a>Hoopecke</a></li>
        </ul>
      </div>
      <a href="/services" class="text-gray-800 hover:text-gray-600">SHËRBIMET</a
      >
      <a href="/product-finder" class="text-gray-800 hover:text-gray-600"
        >SHOP</a
      >
      <a href="/about" class="text-gray-800 hover:text-gray-600">RRETH NESH</a>
      <a href="/karriera" class="text-gray-800 hover:text-gray-600">KARRIERA</a>
      <a href="/contact" class="text-gray-800 hover:text-gray-600">KONTAKT</a>
    </nav>
  </div>
  <div class="flex items-center gap-2">
    {
      logos.map((logo) => (
        <div class="flex h-6 w-6 items-center justify-center">
          <Fragment set:html={logo} />
        </div>
      ))
    }
  </div>
</div>
