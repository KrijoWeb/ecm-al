---
import InstaLogo from "../../svg/instagram.svg?raw";
import LocationSvg from "../../svg/location.svg?raw";
import EmailSvg from "../../svg/email.svg?raw";

const logos = [InstaLogo, LocationSvg, EmailSvg];
---

<div
  id="main-nav"
  class="mask-linear fixed z-[100] flex w-full bg-neutral px-10 backdrop-blur-lg backdrop-filter"
>
  <a href="/" class="my-2">
    <img
      id="main-logo"
      src="/img/EMC_Logo_Black.webp"
      alt="Logo"
      class="object-contain"
    />
  </a>
  <div class="mx-16 flex w-[80vw] items-start *:py-4">
    <nav class="flex flex-1 items-start justify-around border-b-neutral-500 border-b-2">
      <div class="dropdown dropdown-hover group">
        <div
          tabindex="0"
          role="button"
          class="text-gray-800 hover:text-gray-600 peer"
        >
          PRODUKTET
        </div>
        <ul
          id="company-submenu"
          tabindex="0"
          class="[100] menu menu-vertical dropdown-content !relative w-0 h-0 peer-hover:h-fit group-hover:h-fit  hover:h-fit rounded-none p-1 block"
        >
          <li><a href="/products/linde">Linde</a></li>
          <li><a href="/products/hansaflex">HansaFlex</a></li>
          <li><a href="/products/hoppecke">Hoppecke</a></li>
        </ul>
      </div>
      <a href="/services" class="text-gray-800 hover:text-gray-600">SHËRBIMET</a
      >
      <a href="/products" class="text-gray-800 hover:text-gray-600">SHOP</a>
      <a href="/about" class="text-gray-800 hover:text-gray-600">RRETH NESH</a>
      <a href="/karriera" class="text-gray-800 hover:text-gray-600">KARRIERA</a>
      <a href="/contact" class="text-gray-800 hover:text-gray-600">KONTAKT</a>
    </nav>
  </div>
  <div class="flex items-start gap-2 pt-4">
    {
      logos.map((logo) => (
        <div class="flex h-6 w-6 items-center justify-center">
          <Fragment set:html={logo} />
        </div>
      ))
    }
  </div>
</div>
