---
interface Props {
  header?: string;
  img?: string;
  compactNav?: boolean;
  bgPosition?: "top" | "center" | "bottom";
}
const { header, img, bgPosition = "top" } = Astro.props;
const { href } = Astro.url;
---

<header
  id="nav-container"
  class="max-w-screen aspect-[2/1] bg-cover lg:aspect-[4/1]"
  style=`background-image: url("${img}"); background-position: ${bgPosition};`
>
  <div
    id="nav-bg"
    class="relative flex h-full w-full flex-col items-center justify-between bg-neutral-200"
  >
    <slot />
    <div id="header-bg" class="my-auto">
      {
        href.includes("linde") ? (
          <img src="/img/linde/header.png" class="h-10 lg:h-16" />
        ) : href.includes("hansaflex") ? (
          <img src="/img/hansaflex/header.svg" class="h-10 lg:h-16" />
        ) : href.includes("hoppecke") ? (
          <img src="/img/hoppecke/header.png" class="h-10 lg:h-16" />
        ) : (
          <h1
            class="px-4 py-2 text-2xl font-bold capitalize text-black lg:px-6 lg:py-4 lg:text-5xl"
            id="header"
          >
            {header}
          </h1>
        )
      }
    </div>
  </div>
</header>

<style>
  #header-bg {
    transform: skew(-20deg);
  }
  #header {
    transform: skew(20deg);
  }
</style>
<script>
  import { scroll } from "motion";
  const mainNav = document.getElementById("main-nav") as HTMLDivElement;
  const mainLogo = document.getElementById("main-logo") as HTMLImageElement;
  const subMenu = document.getElementById("company-submenu") as HTMLDivElement;
  const navBg = document.getElementById("nav-bg") as HTMLDivElement;
  const navContainer = document.getElementById(
    "nav-container",
  ) as HTMLDivElement;
  const netContainerHeight = navContainer.clientHeight - mainNav.clientHeight;
  const header = document.getElementById("header-bg") as HTMLDivElement;
  scroll((_, { y }) => {
    mainNav.style.backgroundColor = `rgba(230, 231, 235,${
      y.current / netContainerHeight
    })`;
    if (window.innerWidth >= 1024) {
      let mainLogoWidth = 22 - 14 * Math.min(y.current / netContainerHeight, 1);
      mainLogo.style.width = `${mainLogoWidth}rem`;
    }
    subMenu.style.backgroundColor = `rgba(230, 231, 235,${
      y.current / netContainerHeight
    })`;
    if (window.innerWidth >= 1024) {
      let mainNavWidth =
        66 +
        ((y.current + mainNav?.clientHeight) / navContainer?.clientHeight!) *
          33;
      mainNavWidth = mainNavWidth < 100 ? mainNavWidth : 100;
      mainNav.style.width = `${mainNavWidth}vw`;
    }
    let navBgOpacity = y.current / navContainer?.clientHeight! / 2 + 0.6;
    if (navBg)
      navBg.style.backgroundColor = `rgba(230, 231, 235,${navBgOpacity})`;
    if (header)
      header.style.opacity = `${1 - y.current / (netContainerHeight / 2.7)}`;
    if (navContainer)
      navContainer.style.backgroundColor = `rgba(230, 231, 235,${
        y.current / netContainerHeight
      })`;
  });
</script>
