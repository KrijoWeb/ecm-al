<script is:inline defer>
  // Initialize and add the map
  let map;

  async function initMap() {
    // The location of Uluru
    //,
    const position = { lat: 41.339344692475734, lng: 19.48756249732793 };
    const positionKosov = { lat: 42.55129373253288, lng: 21.128013879454244 };
    // Request needed libraries.
    //@ts-ignore
    const { Map } = await window.google.maps.importLibrary("maps");
    const { AdvancedMarkerElement } =
      await window.google.maps.importLibrary("marker");

    // The map, centered at Uluru
    map = new Map(document.getElementById("map"), {
      zoom: 7,
      center: { lat: 41.945319212504, lng: 20.307788188391 },
      mapId: "DEMO_MAP_ID",
    });

    // The marker, positioned at Uluru
    const marker = new AdvancedMarkerElement({
      map: map,
      position: position,
      title: "EMC Durres",
    });

    // The marker, positioned at Uluru
    const markerKosov = new AdvancedMarkerElement({
      map: map,
      position: positionKosov,
      title: "EMC Prishtine",
    });
  }

  initMap();
</script>
