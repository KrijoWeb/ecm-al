---
import Layout from "../layouts/Layout.astro";
import JobCard from "../components/JobCard.astro";
import Jobs from "../constants/jobs.json";
---

<Layout title="Karriera" header="Oferta Pune" img="/img/cover_karriera.webp">
  <div
    class="mx-auto flex w-full flex-col gap-4 px-4 py-12 lg:w-2/3 lg:gap-6 lg:px-0 lg:py-20"
  >
    <div role="alert" class="alert-primary alert my-6 lg:my-10">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="h-6 w-6 shrink-0 stroke-current"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        >
        </path></svg
      >
      <div>
        <span class="text-justify text-sm lg:text-xl">
          Nëse dëshironi të bëheni pjesë e ekipit të EMC, ju ofrojmë mundësi të
          shkëlqyera punesimi dhe zhvillimi te karrierës suaj. Ne besojmë se
          punonjësit tanë janë faktori kryesor në suksesin e kompanisë, prandaj
          investojmë vazhdimisht në trajnim dhe zhvillim profesional. Çdo anëtar
          i ekipit të EMC ka mundësinë të rritet dhe të avancojë në karrierë,
          duke ndjekur një rrugë të qartë dhe të mbështetur nga mundësi
          trajnimesh dhe vlerësimesh të rregullta. Nëse jeni të gatshëm për
          sfida dhe dëshironi të bëni pjesë në një kompani serioze dhe dinamike,
          ne ju mirepresim t'ju takojmë dhe të diskutojmë mundësitë që ofrojmë.
        </span>
      </div>
    </div>
    {
      Jobs.map((job, i) => (
    <JobCard id={`job-${job.id}`} title={job.title} description={job.description} locations={job.location}  />
      ))
    }
  </div>
</Layout>
