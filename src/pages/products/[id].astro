---
import Layout from "../../layouts/Layout.astro";
import Engine from "../../svg/engine.svg?raw";
import Height from "../../svg/height.svg?raw";
import Kilogram from "../../svg/kilogram.svg?raw";
import Euro from "../../svg/euro.svg?raw";
import SimilarProductCard from "../../components/SimilarProductCard.astro";
import { products } from "../../constants/products";
export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const selectedProduct = products.find((p) => p.id == id);
---

<Layout title="Product" compactNav>
  <main id="content" class="mb-12 min-h-svh w-full bg-neutral">
    <div class="mx-auto w-full px-4 py-12 lg:w-2/3 lg:px-0 lg:py-20">
      <div class="breadcrumbs text-xs lg:text-sm">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/products">Shop</a></li>
          <li>{selectedProduct?.description}</li>
        </ul>
      </div>
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:gap-0">
        <div class="basis-full lg:basis-5/12">
          <img
            src={`/img/shop/${selectedProduct?.photo}.webp`}
            class="w-full"
          />
        </div>
        <div
          class="flex basis-full flex-col justify-around gap-6 lg:basis-1/2 lg:gap-0"
        >
          <div class="flex flex-col gap-4">
            <h1
              class="text-center text-xl font-semibold lg:text-left lg:text-3xl"
            >
              {selectedProduct?.description}
            </h1>
            <div class="flex justify-center gap-4 lg:justify-start lg:gap-8">
              <div class="flex flex-col items-center">
                <div class="h-8 w-8 lg:h-12 lg:w-12">
                  <Fragment set:html={Kilogram} />
                </div>
                <p class="text-sm lg:text-base">
                  {selectedProduct?.lifting_capacity_kg} kg
                </p>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-8 w-8 lg:h-12 lg:w-12">
                  <Fragment set:html={Height} />
                </div>
                <p class="text-sm lg:text-base">
                  {selectedProduct?.lifting_height_mm} mm
                </p>
              </div>
              <div class="flex flex-col items-center">
                <div class="h-8 w-8 lg:h-12 lg:w-12">
                  <Fragment set:html={Engine} />
                </div>
                <p class="text-sm lg:text-base">
                  {selectedProduct?.movement_system}
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col items-center gap-4 lg:items-start">
            {
              //@ts-ignore
              selectedProduct?.price ? (
                <div class="gap flex items-center">
                  <div class="h-6 w-6">
                    <Fragment set:html={Euro} />
                  </div>
                  {/*@ts-ignore*/}
                  <p class="text-lg">{selectedProduct?.price}</p>
                </div>
              ) : null
            }
            {
              selectedProduct?.available !== undefined ? (
                <div class="flex gap-2">
                  {selectedProduct?.available ? (
                    <>
                      <div class="h-6 w-6 rounded-full bg-success" />
                      <p>Available</p>
                    </>
                  ) : (
                    <>
                      <div class="h-6 w-6 rounded-full bg-error" />
                      <p>Not Available</p>
                    </>
                  )}
                </div>
              ) : null
            }
          </div>
          <div class="flex flex-col items-center gap-6 lg:items-start">
            <p class="text-sm lg:text-base">
              Jeni te interesuar per kete produkt?
            </p>
            <a
              class="btn btn-primary btn-sm lg:btn-md"
              href={`mailto:info@emc.com.al?subject= Interesohem për ${selectedProduct.description}`}
              >KONTAKTO</a
            >
          </div>
        </div>
      </div>
      <!-- <a -->
      <!--   class="btn text-lg font-thin text-primary mt-3" -->
      <!--   href={`/docs/shop/${selectedProduct?.pdf_file}.pdf`} -->
      <!--   download -->
      <!-- > -->
      <!--   <div class="h-6 w-6 fill-primary"> -->
      <!--     <Fragment set:html={Download} /> -->
      <!--   </div> -->
      <!--   <p class="m-0 p-0 align-bottom">Shkarko dokumentin</p> -->
      <!-- </a> -->
    </div>
  </main>
  <div
    class="mx-auto my-8 flex w-full flex-col gap-4 px-4 lg:my-12 lg:w-2/3 lg:gap-6 lg:px-0"
  >
    <!-- <h1 class="text-center text-3xl">Pershkrimi</h1> -->
    <!-- <p class="text-justify"> -->
    <!--   Lorem ipsum dolor sit amet, officia excepteur ex fugiat reprehenderit enim -->
    <!--   labore culpa sint ad nisi Lorem pariatur mollit ex esse exercitation amet. -->
    <!--   Nisi anim cupidatat excepteur officia. Reprehenderit nostrud nostrud ipsum -->
    <!--   Lorem est aliquip amet voluptate voluptate dolor minim nulla est proident. -->
    <!--   Nostrud officia pariatur ut officia. Sit irure elit esse ea nulla sunt ex -->
    <!--   occaecat reprehenderit commodo officia dolor Lorem duis laboris cupidatat -->
    <!--   officia voluptate. Culpa proident adipisicing id nulla nisi laboris ex in -->
    <!--   Lorem sunt duis officia eiusmod. Aliqua reprehenderit commodo ex non -->
    <!--   excepteur duis sunt velit enim. Voluptate laboris sint cupidatat ullamco -->
    <!--   ut ea consectetur et est culpa et culpa duis. -->
    <!-- </p> -->

    <h1 class="text-center text-2xl lg:text-3xl">Produkte te ngjashme</h1>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      {
        Array.from({ length: 4 }, () =>
          Math.floor(Math.random() * products.length),
        ).map((i) => (
          <SimilarProductCard
            img={`/img/shop/${products.at(i)?.photo}.webp`}
            name={products.at(i)?.description!}
            weight={products.at(i)?.lifting_capacity_kg!}
            height={products.at(i)?.lifting_height_mm!}
          />
        ))
      }
    </div>
  </div>
  <script>
    const nav = document.getElementById("main-nav") as HTMLDivElement;
    const main = document.getElementById("content") as HTMLDivElement;
    main.style.marginTop = `${nav?.clientHeight}px`;
  </script>
</Layout>
