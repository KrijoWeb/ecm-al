---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import FilterCategory from "../../components/FilterCategory.astro";
import Alert from "../../components/alert.astro";
import { ProductFilters } from "../../constants";
import { lindeProducts } from "../../constants/linde-products.ts";
---

<Layout
  title="Produktet tona"
  header="Produktet tona"
  img="/img/linde_new_2.webp"
>
  <div class="flex flex-col items-center gap-10 py-20">
    <Alert>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Architecto,
      adipisci corrupti dolorem eius deserunt, distinctio, inventore cupiditate
      consequuntur aspernatur vel dolore sequi iusto ullam eaque sit porro
      perspiciatis quas? Nihil repellat eligendi mollitia ullam rerum expedita
      dicta quis sapiente libero sunt natus, molestias, minus ad voluptatum
      delectus reprehenderit eaque soluta nam commodi fugit incidunt quisquam.
      Quidem, in! Magnam, ipsa tempore animi architecto sunt, fuga libero illo
      culpa placeat non molestiae doloribus dolores atque provident voluptas
      alis facere ducimus sapiente voluptatum enim possimus quos doloremque!
      Tempora fugit molestias sint quam cumque voluptates deleniti hic
      laudantium porro! Laboriosam officiis voluptatibus minima error.
    </Alert>
    <!-- <div class="flex gap-10"> -->
    <!--   <ProductCategory title="New" count={10} icon={Fork} active /> -->
    <!--   <ProductCategory title="Rental" count={50} icon={Calendar} /> -->
    <!--   <ProductCategory title="Used" count={50} icon={Calendar} /> -->
    <!-- </div> -->
    <div class="flex min-h-screen w-3/4">
      <div class="flex basis-1/4 flex-col gap-4 bg-neutral p-4">
        <input
          type="text"
          placeholder="Model Search"
          class="input rounded-none border-2 border-neutral-300 transition hover:border-neutral-400"
        />
        {ProductFilters.map((pf) => <FilterCategory title={pf} icon="" />)}
      </div>
      <div class="basis-3/4 bg-neutral-100 p-10 py-4">
        <div class="grid h-full grid-cols-2 gap-8">
          {
            lindeProducts.map((p) => (
              <ProductCard
                id={`${p.id}`}
                title={p.description}
                imgSrc={`/img/linde/${p.photo}.avif`}
                category={p.product_type}
                weight={p.lifting_capacity_kg}
                height={p.lifting_height_mm}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
