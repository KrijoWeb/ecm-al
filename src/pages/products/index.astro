---
import Layout from "../../layouts/Layout.astro";
import Alert from "../../components/alert.astro";
import { ProductGrid } from "../../components/ProductGrid.tsx";
import { products } from "../../constants/products";
---

<Layout
  title="Produktet tona"
  header="Produktet tona"
  img="/img/linde/prods_cover.avif"
>
  <div class="flex flex-col items-center gap-10 py-20">
    <Alert>
      Më poshtë do të gjeni mjetet dhe produktet tona që ndodhen në gjendje në
      magazinën tonë dhe janë të gatshme për dorëzim. Na kontaktoni për më shumë
      informacion ose për të bërë porosinë tuaj.
    </Alert>
    {/*@ts-ignore*/}
    <ProductGrid products={products} client:only="solid-js" />
  </div>
</Layout>
