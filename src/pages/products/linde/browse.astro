---
import Layout from "../../../layouts/Layout.astro";
import { ProductGrid } from "../../../components/ProductGrid";
import { lindeProducts } from "../../../constants/linde-products";
---

<Layout
  title="Produktet Linde"
  header="shfleto produktet linde"
  img="/img/linde/prods_cover.avif"
>
  <div class="flex flex-col items-center gap-10 py-20 w-3/4 mx-auto">
    <a class="btn btn-primary self-end" href="/products/linde"> Kthehu tek informacionet</a>
    <ProductGrid
      products={lindeProducts}
      productsCategory="linde"
      client:only="solid-js"
    >
      <div slot="fallback">Loading</div>
    </ProductGrid>
  </div>
</Layout>
