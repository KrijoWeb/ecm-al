---
import Layout from "../layouts/Layout.astro";
import HiddenDescriptionCard from "../components/HiddenDescriptionCard.astro";
---

<Layout img="/img/about-bg.png" title="Sherbimet" header="Sherbimet">
  <div class="mx-auto my-12 grid h-full w-2/3 grid-cols-2 gap-8">
    <HiddenDescriptionCard
      img="/img/about_1.png"
      title="Shërbime të mirëmbajtjes preventive të programuar"
      description="Këto shërbime janë të dizenjuara për të mbajtur mjetet tuaja në gjendje të mire teknike dhe optimale pune por edhe per ti paraprire dhe shmangur difektet e mundshme dhe kostot e tyre. Bazuar ne Standartet e mundësuar nga Linde, për çdo makineri apo pajisje të prodhuar, rekomandohet kryerja e shërbimeve të mirëmbajtjes sipas një programi të caktuar. Në varësi të llojit dhe tipit të mjetit që dispononi ato kanë nevojë për mirëmbajtje çdo 500, 1000, 3000 orë pune. Duke përdorur vetëm pjesë këmbimi origjinale Linde, cilësia e shërbimit tonë është e garantuar. Të gjitha shërbimet e kryera në asetet tuaja, regjistrohen në një program kompiuterik të veçantë, duke krijuar në këtë mënyrë një historik të detajuar të mirëmbajtjes. "
    />
    <HiddenDescriptionCard
      img="/img/about_2.png"
      title="Service 2"
      description="Euismod risus arcu nibh lorem quis consectetur suscipit scelerisque pulvinar."
    />
    <HiddenDescriptionCard
      img="/img/about_3.jpeg"
      title="Service 2"
      description="Euismod risus arcu nibh lorem quis consectetur suscipit scelerisque pulvinar."
    />
    <HiddenDescriptionCard
      img="/img/service.jpeg"
      title="Service 2"
      description="Euismod risus arcu nibh lorem quis consectetur suscipit scelerisque pulvinar."
    />
  </div>
</Layout>
