---
export interface Props {
  imgSrc: string | string[2];
  title: string;
  imgLeft?: boolean;
  height?: number;
  contain?: boolean;
  id?: string;
}
const { imgSrc, title, imgLeft, height, contain, id } = Astro.props;
---

<div
  class="flex flex-col items-stretch gap-4 px-4 lg:flex-row lg:gap-8 lg:px-0"
  id={id}
>
  {
    Array.isArray(imgSrc) ? (
      <>
        <figure
          class="min-h-48 flex-1 lg:min-h-96"
          class:list={{ "object-cover": !contain, "object-contain": contain }}
          style={`height:${height ? height / 2 : 12}rem`}
        >
          <img
            src={imgSrc[0]}
            alt={title}
            class="h-full w-full"
            class:list={{ "object-cover": !contain, "object-contain": contain }}
          />
        </figure>
        <div class="flex flex-1 flex-col items-center gap-4 lg:gap-8">
          <h2 class="text-center text-xl font-semibold capitalize lg:text-3xl">
            {title}
          </h2>
          <p class="text-justify text-sm lg:text-base">
            <slot />
          </p>
        </div>
        <figure
          class="order-last min-h-48 flex-1 lg:order-none lg:min-h-96"
          class:list={{ "object-cover": !contain, "object-contain": contain }}
          style={`height:${height ? height / 2 : 12}rem`}
        >
          <img
            src={imgSrc[1]}
            alt={title}
            class="h-full w-full"
            class:list={{ "object-cover": !contain, "object-contain": contain }}
          />
        </figure>
      </>
    ) : imgLeft ? (
      <>
        <figure
          class="order-last min-h-48 flex-1 lg:order-first lg:min-h-96"
          class:list={{ "object-cover": !contain, "object-contain": contain }}
          style={`height:${height ? height / 1.5 : 16}rem`}
        >
          <img
            src={imgSrc}
            alt={title}
            class="h-full w-full"
            class:list={{ "object-cover": !contain, "object-contain": contain }}
          />
        </figure>
        <div class="flex flex-1 flex-col items-center justify-center gap-4 lg:gap-8">
          <h2 class="text-center text-xl font-semibold capitalize lg:text-3xl">
            {title}
          </h2>
          <p class="text-justify text-sm lg:text-base">
            <slot />
          </p>
        </div>
      </>
    ) : (
      <>
        <div class="flex flex-1 flex-col items-center justify-center gap-4 lg:gap-8">
          <h2 class="text-center text-xl font-semibold capitalize lg:text-3xl">
            {title}
          </h2>
          <p class="text-justify text-sm lg:text-base">
            <slot />
          </p>
        </div>
        <figure
          class="min-h-48 flex-1 lg:min-h-96"
          style={`height:${height ? height / 1.5 : 16}rem`}
        >
          <img
            src={imgSrc}
            alt={title}
            class="h-full w-full"
            class:list={{ "object-cover": !contain, "object-contain": contain }}
          />
        </figure>
      </>
    )
  }
</div>
