---
import SilhouetteIcon from "../svg/silhoutte.svg?raw";
interface Props {
  name: string;
  title: string;
  tel: string;
  fax?: string;
  mobile: string;
  email: string;
}
const { name, title, tel, fax, mobile, email } = Astro.props;
---

<div class="card items-start border-2 border-neutral-200 bg-base-100 shadow-xl">
  <figure class="p-2 size-36"><Fragment set:html={SilhouetteIcon} /></figure>
  <div class="card-body justify-normal gap-2 mt-auto">
    <span class="border-b-4 border-primary text-xl font-semibold w-full">{name}</span>
    <span class="text-lg">{title}</span>
    <a class="font-thin" href={`tel:${tel.trim().replaceAll("-", "")}`}
      >Tel: {tel}</a
    >
    {fax ? <p class="font-thin">Fax: {fax}</p> : null}
    <a class="font-thin" href={`tel:${mobile.trim().replaceAll("-", "")}`}>
      Mob: {mobile}
    </a>
    <a class="font-thin" href={`mailto:${email}`}>Email: {email}</a>
  </div>
</div>
