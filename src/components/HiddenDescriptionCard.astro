---
interface Props {
  img: string;
  title: string;
  description: string;
  aspect?: "landscape" | "portrait";
}
const { img, title, description, aspect } = Astro.props;
---

<div class="flex flex-col gap-2">
  <div
    class="group carousel-item relative z-50 rounded-2xl bg-white transition"
    class:list={{
      "aspect-video": aspect === "landscape",
      "aspect-[6/7]": aspect === "portrait",
    }}
  >
    <img src={img} class="h-full w-full object-cover" />
    <div
      class="absolute bottom-0 flex w-full translate-y-1/2 scale-y-0 flex-col items-center gap-4 rounded-t-2xl bg-black/75 p-4 opacity-0 transition group-hover:translate-y-0 group-hover:scale-y-100 group-hover:opacity-100"
    >
      <h3 class="text-lg font-semibold text-white">{title}</h3>
      <p class="line-clamp-3 font-light text-white">{description}</p>
    </div>
  </div>
  <h3 class="text-lg font-semibold peer-hover:text-white">{title}</h3>
</div>
