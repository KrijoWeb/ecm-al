---
import ArrowButton from "../ArrowButton";
import {
  ServiceCarousel,
  ServiceCarouselControls,
} from "./ServicesCarousel.tsx";
---

<section class="flex w-2/3 flex-col gap-12">
  <div class="flex items-stretch justify-between">
    <div class="flex basis-8/12 flex-col items-center gap-8">
      <h2 class="text-3xl">Sherbimet dhe Mirembajtja</h2>
      <p class="text-justify">
        EMC është një kompani e specializuar në mirëmbajtjen dhe riparimin e
        mjeteve Linde, duke ndjekur praktikat më të mira ndërkombëtare. Ne
        ofrojmë shërbime të mirëmbajtjes dhe riparimit për të siguruar që mjetet
        tuaja të jenë gjithmonë në kushte optimale për punë.
      </p>
      <ServiceCarouselControls client:only />
    </div>
    <div class="flex basis-3/12 flex-col items-end justify-end gap-6">
      <h2 class="my-auto text-center text-3xl">
        Ofrojme cilesi dhe kualitet nga viti 2014
      </h2>
      <div class="translate-y-1/2">
        <ArrowButton
          text="Rreth Nesh"
          type="ellipsis"
          link="/about"
          client:load
        />
      </div>
    </div>
  </div>
  <ServiceCarousel client:only />
</section>
