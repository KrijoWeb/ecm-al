---
import { products } from "../../constants/products";
import ArrowButton from "../ArrowButton";
import ProductCard from "../HiddenDescriptionCard.astro";
---

<section
  id="products-section"
  class="flex h-[90vh] w-full flex-col items-center justify-around bg-neutral-300 px-4 py-4 lg:px-0"
>
  <div class="flex flex-col gap-2 text-center lg:gap-4">
    <h1 class="text-3xl font-semibold text-white lg:text-6xl">
      Visit Our Store
    </h1>
    <h2 class="text-lg font-thin text-white lg:text-3xl">
      Check out our products below
    </h2>
  </div>
  <div
    id="product-carousel"
    class="carousel carousel-center w-full flex-1 space-x-2 rounded-box p-2 lg:w-5/6 lg:space-x-4 lg:p-4 [&>*]:aspect-[3/4]"
  >
    {
      products.map((p) => (
        <ProductCard
          img={`/img/shop/${p.photo}.webp`}
          title={p.description}
          description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
        />
      ))
    }
  </div>
  <div class="flex w-full items-center justify-between px-4 lg:w-1/4 lg:px-0">
    <ArrowButton id="sbb" type="left" />
    <ArrowButton id="sfb" type="right" text="NEXT" />
  </div>
</section>
<style>
  #products-section {
    &::-webkit-scrollbar {
      display: none;
    }
  }
</style>
<script>
  const backBtn = document.getElementById("sbb");
  const forwardBtn = document.getElementById("sfb");
  const carousel = document.getElementById("product-carousel");
  backBtn!.onclick = () => {
    carousel?.scrollTo(carousel.scrollLeft - carousel.scrollWidth / 3, 0);
  };
  forwardBtn!.onclick = () => {
    carousel?.scrollTo(carousel.scrollLeft + carousel.scrollWidth / 3, 0);
  };
</script>
