---
import ArrowButton from "../ArrowButton";
import ProductCard from "../HiddenDescriptionCard.astro";
---

<section
  id="products-section"
  class="flex h-screen w-full flex-col items-center justify-around bg-neutral-300 py-4"
>
  <div class="flex flex-col gap-4 text-center">
    <h1 class="text-6xl font-semibold text-white">Visit Our Store</h1>
    <h2 class="text-3xl font-thin text-white">Check out our products below</h2>
  </div>
  <div
    id="product-carousel"
    class="carousel carousel-center w-5/6 flex-1 space-x-4 rounded-box p-4 [&>*]:aspect-[3/4]"
  >
    <ProductCard
      img="/img/produkt_shop.webp"
      title="Linde L10"
      description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
    />
    <ProductCard
      img="/img/produkt_shop.webp"
      title="Linde L10"
      description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
    />
    <ProductCard
      img="/img/produkt_shop.webp"
      title="Linde L10"
      description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
    />
    <ProductCard
      img="/img/produkt_shop.webp"
      title="Linde L10"
      description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
    />
    <ProductCard
      img="/img/produkt_shop.webp"
      title="Linde L10"
      description="Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
    />
  </div>
  <div class="flex w-1/4 items-center justify-between">
    <ArrowButton id="sbb" type="left" />
    <ArrowButton id="sfb" type="right" text="NEXT" />
  </div>
</section>
<style>
  #products-section {
    &::-webkit-scrollbar {
      display: none;
    }
  }
</style>
<script>
const backBtn = document.getElementById("sbb")
const forwardBtn = document.getElementById("sfb")
const carousel = document.getElementById("product-carousel")
backBtn.onclick = ()=>{carousel?.scrollTo(carousel.scrollLeft - carousel.scrollWidth/3,0)}
forwardBtn.onclick = ()=>{carousel?.scrollTo(carousel.scrollLeft + carousel.scrollWidth/3,0)}
</script>
