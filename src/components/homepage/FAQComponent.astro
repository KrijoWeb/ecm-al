---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div
  class="after:bg-color-primary collapse collapse-arrow rounded-none bg-neutral"
>
  <input type="radio" name="my-accordion-2" checked="checked" />
  <div class="after:color-primary collapse-title text-xl font-medium">
    {title}
  </div>
  <div class="collapse-content">
    <slot />
  </div>
</div>
