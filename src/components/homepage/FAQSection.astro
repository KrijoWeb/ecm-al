---
import FAQComponent from "./FAQComponent.astro";
---

<section
  class="mt-6 flex w-full flex-col items-stretch gap-1 px-4 lg:mt-10 lg:w-2/3 lg:px-0"
>
  <h1 class="my-6 text-center text-3xl font-semibold lg:my-10 lg:text-6xl">
    FAQ
  </h1>
  <FAQComponent title="Cilat marka përfaqësoni?">
    <p>Jemi distributorë zyrtarë të:</p>
    <ul>
      <li>Linde Material Handling</li>
      <li>Hansa-Flex</li>
      <li>Hoppecke Batterien</li>
      <li>TML Technik</li>
    </ul>
  </FAQComponent>
  <FAQComponent title="Çfarë produktesh ofroni?">
    <p>Portofoli ynë i produkteve përfshin:</p>
    <ul>
      <li>
        Forklift dhe pajisje për përpunimin e ngarkesave (elektrik, nafte dhe
        gaz) nga Linde MH
      </li>
      <li>
        Tuba hidraulikë, lidhës dhe komponentë si dhe sisteme dhe zgjidhje
        hidraulike te ndryshme
      </li>
      <li>Bateri industriale, karikues dhe sisteme energjetike nga Hoppecke</li>
      <li>Makineri teleskopike nga TML Technik</li>
    </ul>
  </FAQComponent>
  <FAQComponent title="A ofroni shërbime përveç shitjes së pajisjeve?">
    <p>Po, ne ofrojmë një gamë të gjerë shërbimesh, përfshirë:</p>

    <ul>
      <li>Mirëmbajtje preventive dhe korrektive</li>
      <li>Riparime për një gamë të gjerë mjetesh industriale</li>
      <li>Diagnostikim dhe mirëmbajtje të baterive</li>
      <li>
        Shërbime për sisteme hidraulike, përfshirë zëvendësim tubash në vend
      </li>
      <li>Pjesë këmbimi origjinale nga Linde MH dhe këshillim teknik</li>
    </ul>
  </FAQComponent>
  <FAQComponent
    title="A mund të shërbeni edhe pajisje që nuk janë blerë tek ju?"
  >
    Po, ekipi ynë teknik është i trajnuar për kryerjen e sherbimeve ne pajisje
    industriale nga marka të ndryshme, pavarësisht vendit të blerjes.
  </FAQComponent>
  <FAQComponent title="A ofroni mirëmbajtje në terren?">
    Po, ofrojmë shërbime dhe riparime ne oficinen tone por dhe tek klientet, me
    qellim minimizimin e kohës së ndërprerjes dhe për të ofruar zgjidhje të
    shpejta dhe efikase.
  </FAQComponent>
  <FAQComponent title="A ofroni pjesë këmbimi për pajisjet që shisni?"
    >Po, ofrojmë pjesë këmbimi origjinale për të gjitha markat që përfaqësojmë,
    duke garantuar funksionim optimal dhe jetëgjatësi të pajisjeve tuaja.</FAQComponent
  >
  <FAQComponent
    title="A ofroni zgjidhje të personalizuara hidraulike apo energjetike?"
    >Po, në bashkëpunim me Hansa-Flex dhe Hoppecke, ofrojmë zgjidhje të
    personalizuara për sisteme hidraulike dhe energjie në përputhje me nevojat
    tuaja specifike.</FAQComponent
  >
  <FAQComponent title="Ku ndodheni dhe cilat zona mbuloni?"
    >Ndodhemi në Durres, Shqiperi dhe ne Lipjan, Kosove dhe ofrojmë shërbime për
    klientë në të gjithë Shqipërinë dhe Kosovën.</FAQComponent
  >
</section>
