---
import Height from "../svg/height.svg?raw";
import Kilogram from "../svg/kilogram.svg?raw";
interface Props {
  link: string;
  name: string;
  weight: number;
  height: number;
  img: string;
}
const { link, name, height, weight,  img} = Astro.props;
---

<a href={link}

  class="group md:h-auto h-[50svh] flex flex-1 cursor-pointer flex-col items-center gap-4 border-2 border-neutral-200 px-8 py-4 md:py-12 transition hover:border-primary"
>

  <img src={img} class="h-2/3 transition md:group-hover:scale-110" />
  <p class="text-lg">{name}</p>
  <div class="flex w-full justify-between">
    <div class="flex gap-1">
      <div class="h-4 w-4">
        <Fragment set:html={Kilogram} />
      </div>
      <p>{weight}</p>
    </div>
    <div class="flex gap-1">
      <div class="h-4 w-4">
        <Fragment set:html={Height} />
      </div>
      <p>{height}</p>
    </div>
  </div>
</a>
